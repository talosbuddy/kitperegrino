---
interface Props { eyebrow: string; title: string; highlight?: string; crumbs?: boolean; updated?: string }
const { eyebrow, title, highlight, crumbs = true, updated } = Astro.props;
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const parts = highlight && title.includes(highlight) ? title.split(highlight) : null;
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {crumbs && <nav class="crumbs" aria-label="Migas de pan"><a href="/">Inicio</a> <span>/</span> <span>{eyebrow}</span></nav>}
      <span class="eyebrow">{eyebrow}</span>
      <h1>{parts ? <>{parts[0]}<mark>{highlight}</mark>{parts[1]}</> : title}</h1>
      <div class="hero-lead"><slot /></div>
      {updated && <p class="updated">Actualizado el <time datetime={updated}>{fmt(updated)}</time> · Equipo KitPeregrino · Productos comprobados en Amazon.es</p>}
    </div>
    <div class="hero-side"><slot name="side" /></div>
  </div>
  <svg class="arrow-bg" viewBox="0 0 200 120" aria-hidden="true"><path d="M10 60h150l-45-45m45 45-45 45" stroke="currentColor" stroke-width="22" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
</section>
<style>
  .hero { position: relative; overflow: hidden; background: radial-gradient(1200px 500px at 85% -10%, #1f4a73 0%, transparent 60%), var(--navy); color: #e7eef6; padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem); }
  .hero-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; position: relative; z-index: 1; }
  .hero-grid:has(.hero-side:empty) { grid-template-columns: 1fr; max-width: 860px; }
  .crumbs { font-size: .85rem; color: #9fb7cf; margin-bottom: 1rem; }
  .crumbs a { color: #cfe0f0; text-decoration: none; }
  .hero :global(.eyebrow) { background: rgba(245,196,0,.16); color: var(--sun); }
  h1 { color: #fff; font-size: clamp(2.1rem, 5.4vw, 3.6rem); font-weight: 800; margin: 0 0 1.2rem; }
  mark { background: none; color: var(--sun); }
  .hero-lead { font-size: 1.1rem; color: #d4e0ec; max-width: 60ch; }
  .hero-lead :global(strong) { color: #fff; }
  .hero-lead :global(a) { color: #fff; }
  .updated { font-size: .85rem; color: #9fb7cf; margin-top: 1.2rem; }
  .arrow-bg { position: absolute; right: -40px; bottom: -40px; width: 420px; color: rgba(245,196,0,.08); }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
