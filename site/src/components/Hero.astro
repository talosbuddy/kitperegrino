---
interface Props { eyebrow: string; title: string; highlight?: string; crumbs?: boolean; updated?: string }
const { eyebrow, title, highlight, crumbs = true, updated } = Astro.props;
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const parts = highlight && title.includes(highlight) ? title.split(highlight) : null;
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {crumbs && <nav class="crumbs" aria-label="Migas de pan"><a href="/">Inicio</a> <span>/</span> <span>{eyebrow}</span></nav>}
      <span class="eyebrow">{eyebrow}</span>
      <h1>{parts ? <>{parts[0]}<mark>{highlight}</mark>{parts[1]}</> : title}</h1>
      <div class="hero-lead"><slot /></div>
      {updated && <p class="updated">Actualizado el <time datetime={updated}>{fmt(updated)}</time> · Equipo KitPeregrino · Productos comprobados en Amazon.es</p>}
    </div>
    <div class="hero-side"><slot name="side" /></div>
  </div>
</section>
<style>
.hero { position: relative; overflow: hidden; background: var(--paper); color: var(--ink); padding: clamp(2.2rem, 5vw, 4rem) 0 clamp(2.8rem, 6vw, 4.5rem); border-bottom: 1px solid rgba(29,33,31,.08); }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(1.5rem, 5vw, 4.5rem); align-items: start; position: relative; z-index: 1; }
  .hero-grid:has(.hero-side:empty) { grid-template-columns: 1fr; max-width: 900px; }
  .hero-side:empty { display: none; }
  .crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 1.6rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; }
  h1 { color: var(--navy-2); font-size: clamp(2.3rem, 5.6vw, 4.1rem); font-weight: 600; line-height: 1.02; letter-spacing: -.035em; margin: 0 0 1.4rem; max-width: 17ch; }
  mark { background: none; color: inherit; font-style: italic; font-weight: 400; background-image: linear-gradient(transparent 72%, rgba(228,167,12,.38) 72%, rgba(228,167,12,.38) 92%, transparent 92%); padding: 0 .05em; }
  .hero-lead { font-size: 1.12rem; color: #3e443f; max-width: 58ch; }
  .hero-lead :global(strong) { color: var(--ink); }
  .updated { display: flex; flex-wrap: wrap; gap: .3rem 1rem; font-size: .84rem; color: var(--muted); margin-top: 1.6rem; padding-top: 1rem; border-top: 1px solid var(--line); max-width: 58ch; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
