---
import { guides, PUBLISHED } from '../data/site';
const { exclude, withMochila = false } = Astro.props as { exclude?: string; withMochila?: boolean };
const list = [
  ...(withMochila ? [{ slug: 'mochila-del-camino', title: 'Mochila del Camino', desc: 'La checklist completa: 16 imprescindibles y el kit en un clic.' }] : []),
  ...guides.filter(g => g.slug !== exclude),
];
const ready = (s: string) => s === 'mochila-del-camino' || PUBLISHED.has(s);
---
<ul class="guides">
  {list.map(g => (
    <li><a href={`/${g.slug}/`}>
      <span class="t">{g.title}</span>
      <span class="d">{g.desc}</span>
      <span class:list={['st', ready(g.slug) ? 'ok' : 'soon']}>{ready(g.slug) ? <span aria-label="Leer guía">→</span> : 'Próximamente'}</span>
    </a></li>
  ))}
</ul>
<style>
.guides { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 2.5rem; border-top: 1px solid var(--line); counter-reset: g; }
  .guides li { counter-increment: g; }
  .guides a { display: grid; grid-template-columns: 2.6rem 1fr auto; column-gap: .9rem; align-items: baseline; padding: 1.15rem 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); height: 100%; }
  .guides a::before { content: counter(g, decimal-leading-zero); font-family: var(--serif); color: var(--muted); font-size: 1.05rem; grid-row: span 2; transition: color .2s; }
  .guides a:hover::before { color: var(--sun); }
  .t { font-family: var(--serif); font-weight: 600; font-size: 1.2rem; color: var(--navy-2); line-height: 1.25; letter-spacing: -.01em; }
  .d { grid-column: 2 / 4; font-size: .92rem; color: var(--muted); }
  .st { grid-row: 1; grid-column: 3; font-size: 1.1rem; color: var(--navy-2); transition: transform .2s var(--ease); }
  .guides a:hover .st { transform: translateX(4px); }
  .guides a:hover .t { text-decoration: underline; text-decoration-color: var(--sun); text-underline-offset: 4px; }
  .st.soon { font-size: .75rem; color: #9a8a6c; }
  @media (max-width: 760px) { .guides { grid-template-columns: 1fr; } }
</style>
