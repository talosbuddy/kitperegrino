---
import { guides, PUBLISHED } from '../data/site';
import { iconFor } from '../data/icons';
import Icon from './Icon.astro';
const ICON: Record<string,string> = { 'mochila-del-camino': 'mochila', calzado: 'calzado', 'botiquin-y-ampollas': 'botiquin', 'kit-de-albergue': 'albergue', 'camino-en-verano': 'sol', 'camino-en-invierno': 'frio', 'frances-vs-portugues': 'ruta', 'bicicleta-camino-de-santiago': 'bici', 'camino-en-bici-y-con-ninos': 'bici', 'ropa-del-camino': 'ropa' };
const { exclude, withMochila = false } = Astro.props as { exclude?: string; withMochila?: boolean };
const list = [
  ...(withMochila ? [{ slug: 'mochila-del-camino', title: 'Mochila del Camino', desc: 'La checklist completa: 16 imprescindibles y el kit en un clic.' }] : []),
  ...guides.filter(g => g.slug !== exclude),
];
const ready = (s: string) => s === 'mochila-del-camino' || PUBLISHED.has(s);
---
<ul class="guides">
  {list.map(g => (
    <li><a href={`/${g.slug}/`}>
      <span class="gic"><Icon name={ICON[g.slug] ?? iconFor(g.title)} size={26} /></span>
      <span class="t">{g.title}</span>
      <span class="d">{g.desc}</span>
      <span class:list={['st', ready(g.slug) ? 'ok' : 'soon']}>{ready(g.slug) ? <span aria-label="Leer guía">→</span> : 'Próximamente'}</span>
    </a></li>
  ))}
</ul>
<style>
.guides { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }
  .guides a { display: flex; flex-direction: column; gap: .35rem; height: 100%; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.3rem; text-decoration: none; color: var(--ink); box-shadow: var(--shadow); transition: transform .18s var(--ease), box-shadow .18s, border-color .18s; }
  .guides a:hover { transform: translateY(-4px); border-color: var(--sun); box-shadow: 0 22px 40px -18px rgba(10,38,71,.35); }
  .gic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--navy); color: var(--sun); margin-bottom: .5rem; transition: transform .25s var(--ease); }
  .guides a:hover .gic { transform: rotate(-6deg) scale(1.06); }
  .t { font-family: var(--serif); font-weight: 700; font-size: 1.18rem; color: var(--navy-2); line-height: 1.2; }
  .d { font-size: .92rem; color: var(--muted); flex: 1; }
  .st { align-self: flex-start; margin-top: .6rem; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--sky); color: var(--navy); font-weight: 800; transition: background .15s, transform .2s var(--ease); }
  .guides a:hover .st { background: var(--sun); transform: translateX(4px); }
  .st.soon { width: auto; border-radius: 999px; padding: 0 .7rem; font-size: .75rem; color: #8a6400; background: #fff4d1; }
</style>
