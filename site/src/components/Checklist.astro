---
import type { Group } from '../data/checklist';
import { amazon, cartAsins } from '../data/site';
import { iconFor } from '../data/icons';
import Icon from './Icon.astro';
import AffiliateNotice from './AffiliateNotice.astro';
const { checklist, cartUrl } = Astro.props as { checklist: Group[]; cartUrl: string };
const inCart = new Set(cartAsins(cartUrl));
let n = 0;
---
<div class="groups">
  <AffiliateNotice />
{checklist.map(group => (
  <section class="group">
    <h3 class="group-title"><span class="gi"><Icon name={iconFor(group.title)} size={22} /></span>{group.title} <span class="gc">{group.items.length}</span></h3>
    <ol class="cards">
      {group.items.map(item => { n++; const k = inCart.has(item.asin); return (
        <li class="card">
          <div class="card-top">
            <span class="pic"><Icon name={iconFor(item.what, group.title)} size={30} /></span>
            <span class="num">{String(n).padStart(2, '0')}</span>
            
          </div>
          <h4>{item.what}</h4>
          <p class="pick">Nuestra elección: <strong>{item.name}</strong></p>
          <p class="why"><span>Por qué</span> {item.why}{item.link && <>{' '}{item.link.pre}{' '}<a href={item.link.href}>{item.link.text}</a>.</>}</p>
          {item.drawback && <p class="drawback"><span>Limitación</span> {item.drawback}</p>}
          {item.alternative && <p class="alt"><span>Alternativa</span> {item.alternative}</p>}
          <div class="meta">
            <a class="see" href={amazon(item.asin)} rel="sponsored nofollow noopener" target="_blank">Ver en Amazon · enlace de afiliado <span aria-hidden="true">↗</span></a>
            <span class:list={['note', k ? 'in' : 'size']}>{k ? 'Incluido en el kit' : 'Elige talla o color'}</span>
          </div>
        </li>
      ); })}
    </ol>
  </section>
))}
</div>
<style>
.groups { display: grid; gap: 3rem; }
  .group-title { display: flex; align-items: center; gap: .7rem; font-size: 1.5rem; margin: 0 0 1.1rem; }
  .gi { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--navy); color: var(--sun); flex: none; }
  .gc { font-family: var(--sans); font-size: .8rem; font-weight: 800; background: var(--sun); color: var(--navy-2); border-radius: 999px; padding: .15rem .6rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.1rem; }
  .card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform .18s var(--ease), box-shadow .18s; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(10,38,71,.06), 0 22px 40px -16px rgba(10,38,71,.35); }
  .card-top { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 1.2rem; background: linear-gradient(135deg, var(--sky), #f6f9fd); border-bottom: 1px solid var(--line); }
  .pic { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 16px; background: #fff; color: var(--navy); box-shadow: 0 6px 16px -8px rgba(10,38,71,.35); transition: transform .25s var(--ease), background .2s, color .2s; }
  .card:hover .pic { transform: rotate(-6deg) scale(1.06); background: var(--navy); color: var(--sun); }
  .num { font-family: var(--serif); font-weight: 800; font-size: 2.2rem; color: rgba(15,61,115,.16); line-height: 1; }
  .card > :not(.card-top) { margin-left: 1.25rem; margin-right: 1.25rem; }
  h4 { font-family: var(--serif); font-size: 1.2rem; line-height: 1.25; margin: 1rem 0 .3rem; color: var(--navy-2); }
  .pick { margin: 0 0 .7rem; font-size: .9rem; color: var(--muted); }
  .pick strong { color: var(--ink); }
  .why, .drawback, .alt { margin: 0 0 .7rem; font-size: .95rem; color: #34465e; }
  .why { flex: 1; margin-bottom: 1rem; }
  .why > span, .drawback > span, .alt > span { display: inline-block; font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--navy-2); background: #fff1b3; border-radius: 6px; padding: .05rem .4rem; margin-right: .25rem; }
  .drawback > span, .alt > span { background: var(--sky); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; padding: .9rem 0 1.1rem; border-top: 1px dashed var(--line); }
  .see { display: inline-flex; align-items: center; gap: .35rem; font-weight: 800; font-size: .85rem; text-decoration: none; color: var(--navy-2); background: var(--sun); border-radius: 999px; padding: .5rem .95rem; transition: background .15s; }
  .see:hover { background: var(--sun-2); color: var(--navy-2); }
  .see span { display: inline-block; transition: transform .2s var(--ease); }
  .see:hover span { transform: translate(2px, -2px); }
  .note { font-size: .76rem; font-weight: 700; border-radius: 999px; padding: .22rem .6rem; }
  .note.in { background: #e3f4ea; color: var(--green); }
  .note.in::before { content: "✓ "; }
  .note.size { background: #fff4d1; color: #8a6400; }
</style>
