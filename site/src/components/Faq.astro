---
const { faqs } = Astro.props as { faqs: { q: string; a: string }[] };
---
<h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
<div class="faq">
{faqs.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>))}
</div>
<style>
  .faq { display: grid; gap: .7rem; }
  details { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 0 1.2rem; box-shadow: var(--shadow); }
  summary { list-style: none; cursor: pointer; font-weight: 700; padding: 1rem 2rem 1rem 0; position: relative; color: var(--navy-2); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; position: absolute; right: 0; top: .75rem; font-size: 1.4rem; color: #c39a00; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 0 0 1.1rem; color: #3a4452; }
</style>
