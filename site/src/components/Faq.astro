---
const { faqs } = Astro.props as { faqs: { q: string; a: string }[] };
---
<h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
<div class="faq">
{faqs.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>))}
</div>
<style>
.faq { display: grid; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; font-family: var(--serif); font-weight: 600; font-size: 1.12rem; padding: 1.15rem 2.5rem 1.15rem 0; position: relative; color: var(--navy-2); transition: color .15s; }
  summary:hover { color: #000; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-family: var(--sans); font-weight: 300; position: absolute; right: .2rem; top: .9rem; font-size: 1.5rem; color: var(--muted); transition: transform .25s var(--ease); }
  details[open] summary::after { transform: rotate(45deg); color: var(--sun); }
  details p { margin: 0 0 1.3rem; color: #3e443f; max-width: 65ch; }
</style>
