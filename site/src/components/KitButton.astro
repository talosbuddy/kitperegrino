---
import { CART_URL, cartAsins } from '../data/site';
interface Props { url?: string; label?: string; title?: string; note?: string; variant?: 'card' | 'band' }
const { url = CART_URL, label = 'Añadir el kit básico al carrito de Amazon', title = 'Kit básico listo', note, variant = 'card' } = Astro.props;
const count = cartAsins(url).length;
---
<aside class:list={['kit', variant]} aria-label="Kit completo en Amazon">
  <div class="kit-head">
    <span class="count"><b>{count}</b> artículos</span>
    <h2 class="kit-title">{title}</h2>
    <p class="kit-sub">Un clic y los añades todos a tu carrito de Amazon.es. Revisa antes de pagar y quita lo que ya tengas.</p>
  </div>
  <a class="btn" href={url} rel="sponsored nofollow noopener" target="_blank">{label} <span class="arr" aria-hidden="true">↗</span></a>
  {note && <p class="kit-note">{note}</p>}
  <ul class="trust">
    <li>ASIN comprobados uno a uno</li>
    <li>Sin precios: los fija Amazon</li>
    <li>Enlace de afiliado</li>
  </ul>
</aside>
<style>
.kit { background: #fffdf8; color: var(--ink); border-radius: var(--radius); padding: 1.6rem; border: 1px solid var(--line); box-shadow: 0 1px 0 rgba(23,32,27,.04), 0 24px 48px -32px rgba(23,32,27,.35); position: relative; }
  .kit::before { content: ""; position: absolute; left: 1.6rem; right: 1.6rem; top: -1px; height: 3px; background: var(--sun); border-radius: 0 0 3px 3px; }
  .band { margin: 0 auto; max-width: 900px; display: grid; grid-template-columns: 1fr auto; gap: .5rem 2.5rem; align-items: center; background: var(--navy-2); color: #d8dcd4; border: 0; padding: clamp(1.6rem, 4vw, 2.4rem); }
  .band::before { display: none; }
  .band .kit-title { color: #f6f2ea; }
  .band .kit-sub, .band .kit-note, .band .trust { color: #b9c1b9; }
  .band .count { color: var(--sun); }
  .band .kit-note, .band .trust { grid-column: 1 / -1; }
  .count { display: inline-block; font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .kit-title { font-size: 1.55rem; margin: .4rem 0 .4rem; max-width: none; }
  .kit-sub { margin: 0 0 1.2rem; color: var(--muted); font-size: .95rem; }
  .btn { display: flex; justify-content: center; align-items: center; gap: .6rem; text-align: center; background: var(--sun); color: var(--navy-2); font-weight: 700; font-size: 1rem; padding: .95rem 1.3rem; border-radius: 10px; text-decoration: none; box-shadow: inset 0 -2px 0 rgba(0,0,0,.12); transition: background .15s, transform .15s var(--ease); }
  .btn:hover { background: var(--sun-2); color: var(--navy-2); transform: translateY(-1px); }
  .btn:active { transform: translateY(1px); }
  .btn:focus-visible { outline: 2px solid var(--navy-2); outline-offset: 3px; }
  .btn .arr { transition: transform .2s var(--ease); }
  .btn:hover .arr { transform: translate(2px, -2px); }
  @media (max-width: 480px) { .kit { padding: 1.25rem; } .kit-title { font-size: 1.35rem; } .btn { font-size: .96rem; padding: .9rem 1rem; } }
  .kit-note { font-size: .86rem; color: var(--muted); margin: .9rem 0 0; }
  .trust { list-style: none; padding: 1rem 0 0; margin: 1rem 0 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; font-size: .8rem; color: var(--muted); }
  .band .trust { border-top-color: rgba(255,255,255,.1); }
  .trust li::before { content: "✓ "; color: var(--green); font-weight: 700; }
  .band .trust li::before { color: var(--sun); }
  @media (max-width: 700px) { .band { grid-template-columns: 1fr; } }
</style>
