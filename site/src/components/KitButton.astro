---
import { CART_URL, cartAsins } from '../data/site';
interface Props { url?: string; label?: string; title?: string; note?: string; variant?: 'card' | 'band' }
const { url = CART_URL, label = 'Añadir el kit básico al carrito de Amazon', title = 'Kit básico listo', note, variant = 'card' } = Astro.props;
const count = cartAsins(url).length;
---
<aside class:list={['kit', variant]} aria-label="Kit completo en Amazon">
  <div class="kit-head">
    <span class="count"><b>{count}</b> artículos</span>
    <h2 class="kit-title">{title}</h2>
    <p class="kit-sub">Un clic y los añades todos a tu carrito de Amazon.es. Revisa antes de pagar y quita lo que ya tengas.</p>
  </div>
  <a class="btn" href={url} rel="sponsored nofollow noopener" target="_blank">🛒 {label}</a>
  {note && <p class="kit-note">{note}</p>}
  <ul class="trust">
    <li>✓ ASIN comprobados uno a uno</li>
    <li>✓ Sin precios: los fija Amazon</li>
    <li>✓ Enlace de afiliado</li>
  </ul>
</aside>
<style>
  .kit { background: #fff; color: var(--ink); border-radius: 22px; padding: 1.6rem; box-shadow: 0 30px 60px -25px rgba(0,0,0,.45); border: 1px solid var(--line); }
  .band { margin: 0 auto; max-width: 860px; display: grid; grid-template-columns: 1fr auto; gap: .5rem 2rem; align-items: center; background: linear-gradient(135deg, #fff9df, #fff); border: 2px solid var(--sun); box-shadow: var(--shadow); }
  .band .kit-note, .band .trust { grid-column: 1 / -1; }
  .count { display: inline-block; font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--green); background: #e5f3ea; border-radius: 999px; padding: .25rem .65rem; }
  .count b { font-size: .95rem; }
  .kit-title { font-size: 1.6rem; margin: .6rem 0 .3rem; }
  .kit-sub { margin: 0 0 1.1rem; color: var(--muted); font-size: .95rem; }
  .btn { display: flex; justify-content: center; align-items: center; gap: .4rem; text-align: center; background: var(--sun); color: var(--navy-2); font-weight: 800; font-size: 1.02rem; padding: 1rem 1.3rem; border-radius: 14px; text-decoration: none; box-shadow: 0 4px 0 #c99f00; transition: transform .08s, box-shadow .08s, background .15s; }
  .btn:hover { background: var(--sun-2); color: var(--navy-2); }
  .btn:active { transform: translateY(3px); box-shadow: 0 1px 0 #c99f00; }
  .kit-note { font-size: .86rem; color: var(--muted); margin: .9rem 0 0; }
  .trust { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: .82rem; color: var(--muted); }
  @media (max-width: 700px) { .band { grid-template-columns: 1fr; } }
</style>
