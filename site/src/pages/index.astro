---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { CART_URL, CART_URL_CALZADO, cartAsins, guides } from '../data/site';
import Faq from '../components/Faq.astro';
import { website, faqPage } from '../data/schema';
const site = 'https://kitperegrino.com';
const glosario = [
  ['Credencial', 'El «pasaporte» del peregrino. Se sella en albergues, iglesias, bares y oficinas de turismo, y es lo que presentas para pedir la Compostela.'],
  ['Compostela', 'Certificado gratuito, en latín, que expide la Oficina del Peregrino de la Catedral de Santiago a quien cumple la distancia mínima.'],
  ['Sello', 'La marca con fecha que te ponen en la credencial. Demuestra por dónde has pasado.'],
  ['Albergue', 'Alojamiento compartido para peregrinos con credencial. Puede ser público, parroquial o privado.'],
  ['Etapa', 'El tramo que se camina en un día, normalmente entre dos poblaciones con albergue.'],
  ['Flecha amarilla', 'La señal pintada que marca el Camino, junto a la concha de vieira de los mojones.'],
  ['Mojón', 'Hito de piedra con la concha y, en Galicia, los kilómetros que faltan hasta Santiago.'],
  ['Hospitalero', 'La persona, a menudo voluntaria, que atiende el albergue.'],
  ['Meseta', 'El tramo llano de Castilla y León en el Camino Francés, aproximadamente entre Burgos y León: mucho sol y poca sombra.'],
  ['Sarria', 'El punto de salida más habitual del Francés para hacer los últimos 100 km a pie.'],
  ['Año Santo (Xacobeo)', 'El año en que el 25 de julio, día de Santiago, cae en domingo. Se abre la Puerta Santa de la Catedral y suele haber más peregrinos.'],
  ['Concha de vieira', 'El símbolo del peregrino. Muchos la cuelgan de la mochila y aparece en los mojones que marcan el Camino.'],
  ['Bordón', 'El bastón tradicional del peregrino. Hoy casi todos usan bastones de trekking.'],
  ['Albergue de donativo', 'Albergue sin precio fijo: cada peregrino deja lo que puede para que siga abierto.'],
  ['Transporte de mochilas', 'Servicio que lleva tu mochila de un alojamiento al siguiente para que camines solo con lo del día.'],
  ['Fisterra (Finisterre)', 'El cabo de la costa gallega al que muchos peregrinos siguen caminando después de llegar a Santiago.'],
  ['Peregrino', 'Quien recorre el Camino a pie, en bici o a caballo hacia Santiago, con credencial.'],
];
const homeFaqs = [
  { q: '¿Cuántos kilómetros hay que hacer para conseguir la Compostela?', a: 'Al menos los últimos 100 km continuos a pie o a caballo, o 200 km en bicicleta, por un mismo camino reconocido y en dirección a Santiago, según la Oficina del Peregrino.' },
  { q: '¿Cuánto cuesta la Compostela?', a: 'Nada: la Oficina del Peregrino la entrega gratis. Se recoge en persona en el Centro Internacional de Acogida al Peregrino, Rúa Carretas 33, en Santiago.' },
  { q: '¿Se puede hacer el Camino por partes en distintos años?', a: 'Sí, si las etapas van en orden geográfico y cronológico. Si solo haces la distancia mínima, sella al principio y al final de cada etapa, con fecha.' },
  { q: '¿Puedo mezclar dos Caminos distintos?', a: 'No para la Compostela: la Oficina del Peregrino pide recorrer una misma ruta sin alternar ni mezclar caminos.' },
];
const all = [{ slug: 'mochila-del-camino', title: 'Mochila del Camino' }, ...guides];
const jsonLd = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Guías de KitPeregrino para el Camino de Santiago', itemListElement: all.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.title, url: `${site}/${g.slug}/` })) };
const ld = [jsonLd, website(), faqPage(homeFaqs)];
const paths = [
  { q: 'Es mi primer Camino', a: 'Empieza por la mochila y el calzado: son lo que más se nota en el cuerpo.', links: [['/mochila-del-camino/', 'Mochila'], ['/calzado/', 'Calzado']] },
  { q: 'Aún no sé qué ruta hacer', a: 'Compara distancia, etapas y ambiente antes de comprar nada.', links: [['/frances-vs-portugues/', 'Francés vs Portugués']] },
  { q: 'Ya tengo fecha', a: 'La estación cambia la ropa, el agua y dónde dormir.', links: [['/camino-en-verano/', 'Verano'], ['/camino-en-invierno/', 'Invierno']] },
  { q: 'Dormiré en albergues', a: 'Saco sábana, tapones y cómo evitar chinches.', links: [['/kit-de-albergue/', 'Kit de albergue']] },
  { q: 'Me preocupan las ampollas', a: 'Prevención, botiquín y cómo curarlas en ruta.', links: [['/botiquin-y-ampollas/', 'Botiquín'], ['/calzado/#rutina', 'Rutina de pies']] },
  { q: 'Voy en bici o con niños', a: 'Etapas, equipo y requisitos para la Compostela.', links: [['/camino-en-bici-y-con-ninos/', 'Bici y niños']] },
];
---
<Base title="KitPeregrino: qué llevar al Camino de Santiago" description="Guías y checklists para preparar la mochila del Camino de Santiago: calzado, botiquín, albergue, verano, invierno, rutas, bici y niños." jsonLd={ld}>
  <Hero eyebrow="Camino de Santiago" title="Prepara tu Camino de Santiago con lo justo" highlight="con lo justo" crumbs={false}>
    <p>Checklists cortas y razonadas para que la mochila no pese más de lo necesario. Cada artículo explica <strong>por qué</strong> está en la lista, y el kit entero entra en tu carrito con un clic.</p>
    <p class="hero-ctas"><a class="cta-main" href="/mochila-del-camino/">Ver la lista de la mochila <span class="arr" aria-hidden="true">→</span></a> <a class="cta-ghost" href="/calzado/">Calzado y ampollas</a></p>
    <ul slot="side" class="steps">
      <li><b>1</b><span><strong>Lee la checklist.</strong> Cada artículo trae su porqué y nada más.</span></li>
      <li><b>2</b><span><strong>Añade el kit.</strong> {cartAsins(CART_URL).length} básicos de mochila o {cartAsins(CART_URL_CALZADO).length} de cuidado de pies, en un clic.</span></li>
      <li><b>3</b><span><strong>Elige tus tallas.</strong> El calzado y la ropa, a tu medida.</span></li>
    </ul>
  </Hero>
  <section class="block" id="guias">
    <div class="wrap">
      <span class="eyebrow">Guías</span>
      <h2>Guías por tema</h2>
      <GuideLinks withMochila />
    </div>
  </section>
  <section class="block" id="empieza">
    <div class="wrap">
      <span class="eyebrow">Por dónde empiezo</span>
      <h2>Elige según tu situación</h2>
      <ul class="paths">
        {paths.map(p => (
          <li><strong>{p.q}</strong><span>{p.a}</span><span class="pl">{p.links.map(([h, t]) => <a href={h}>{t} →</a>)}</span></li>
        ))}
      </ul>
    </div>
  </section>
  <section class="block" id="epoca">
    <div class="wrap">
      <span class="eyebrow">Mejor época</span>
      <h2>Cuándo hacer el Camino de Santiago: época por época</h2>
      <p class="lead">Primavera y otoño son las épocas más cómodas para la mayoría; el verano trae calor y más gente, y el invierno frío, lluvia y menos albergues abiertos.</p>
      <div class="tw"><table class="dt">
        <thead><tr><th>Época</th><th>Cómo es</th><th>Qué cambia en la mochila</th><th>Guía</th></tr></thead>
        <tbody>
          <tr><td>Primavera (abril-junio)</td><td>Temperaturas suaves, lluvia posible y más peregrinos según se acerca el verano.</td><td>Chubasquero y una capa media.</td><td><a href="/mochila-del-camino/">Mochila</a></td></tr>
          <tr><td>Verano (julio-septiembre)</td><td>Calor en la Meseta y el interior, mucha gente en los últimos 100 km.</td><td>Más agua, gorra, protector solar, saco sábana.</td><td><a href="/camino-en-verano/">Verano</a></td></tr>
          <tr><td>Otoño (octubre-noviembre)</td><td>Menos gente, días más cortos y lluvia frecuente en Galicia.</td><td>Calzado que seque, frontal y chubasquero.</td><td><a href="/calzado/">Calzado</a></td></tr>
          <tr><td>Invierno (diciembre-marzo)</td><td>Frío, nieve posible en montaña y muchos albergues cerrados.</td><td>Capas térmicas, saco ligero, guantes.</td><td><a href="/camino-en-invierno/">Invierno</a></td></tr>
        </tbody>
      </table></div>
    </div>
  </section>
  <section class="block alt" id="compostela">
    <div class="narrow prose">
      <span class="eyebrow">Credencial y Compostela</span>
      <h2>Credencial y Compostela: requisitos</h2>
      <p>Para recibir la Compostela hay que recorrer al menos los últimos 100 km a pie o a caballo, o 200 km en bicicleta, por un mismo camino reconocido y en dirección a Santiago, con la credencial sellada.</p>
      <ul>
        <li><strong>Distancia:</strong> 100 km continuos a pie o a caballo; 200 km en bici. Si empiezas fuera de España, al menos 70 km continuos en territorio español.</li>
        <li><strong>Sellos:</strong> si solo haces la distancia mínima o vas por partes, sella al principio y al final de cada etapa, con fecha.</li>
        <li><strong>Una sola ruta:</strong> no se pueden alternar ni mezclar caminos.</li>
        <li><strong>En persona y gratis:</strong> se recoge en el Centro Internacional de Acogida al Peregrino (Rúa Carretas, 33), tras registrarte con un código QR.</li>
        <li><strong>Niños:</strong> pueden recibir la Compostela o un certificado especial según su edad.</li>
      </ul>
      <p class="muted">Fuente: <a href="https://oficinadelperegrino.com/peregrinacion/la-compostela/" rel="noopener">Oficina del Peregrino, «La Compostela»</a>. La credencial no se vende en Amazon: consíguela en asociaciones de amigos del Camino, parroquias, albergues de salida o la propia Oficina.</p>
    </div>
  </section>
  <section class="block" id="glosario">
    <div class="narrow">
      <span class="eyebrow">Glosario</span>
      <h2>Glosario del peregrino</h2>
      <p class="lead">Las palabras del Camino que verás en todas nuestras guías.</p>
      <dl class="glos">{glosario.map(([t, d]) => <><dt>{t}</dt><dd>{d}</dd></>)}</dl>
    </div>
  </section>
  <section class="block alt">
    <div class="narrow"><Faq faqs={homeFaqs} /></div>
  </section>
</Base>
<style>
  .hero-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.4rem; margin-top: 1.8rem; }
  .cta-main { display: inline-flex; gap: .5rem; background: var(--navy-2); color: #f6f2ea !important; font-weight: 600; text-decoration: none; padding: .95rem 1.4rem; border-radius: 10px; transition: background .15s; }
  .cta-main:hover { background: #000; }
  .cta-ghost { color: var(--navy-2) !important; font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--sun); padding-bottom: 2px; }
  .steps { list-style: none; margin: .4rem 0 0; padding: 0; display: grid; counter-reset: s; border-top: 2px solid var(--navy-2); }
  .steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: .8rem; padding: 1.15rem 0; border-bottom: 1px solid var(--line); color: #3e443f; }
  .steps b { font-family: var(--serif); font-weight: 400; font-size: 1.6rem; line-height: 1.1; color: var(--sun); }
  .steps strong { display: block; font-family: var(--serif); font-weight: 600; font-size: 1.12rem; color: var(--navy-2); }
  .paths { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .paths li { display: flex; flex-direction: column; gap: .35rem; background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--navy-2); border-radius: 4px; padding: 1.1rem 1.2rem; }
  .paths strong { font-family: var(--serif); color: var(--navy-2); font-size: 1.05rem; }
  .paths span { color: var(--muted); font-size: .92rem; }
  .paths .pl { display: flex; flex-wrap: wrap; gap: .3rem 1rem; margin-top: .2rem; }
  .paths a { font-weight: 700; color: var(--navy); font-size: .9rem; }
  .glos { display: grid; grid-template-columns: max-content 1fr; gap: .6rem 1.2rem; margin: 0; }
  .glos dt { font-weight: 700; color: var(--navy-2); }
  .glos dd { margin: 0; }
  @media (max-width: 560px) { .glos { grid-template-columns: 1fr; } .glos dd { margin-bottom: .6rem; } }
  .tw { overflow-x: auto; }
  .dt { width: 100%; border-collapse: collapse; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); font-size: .97rem; }
  .dt th, .dt td { padding: .75rem 1rem; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  .dt th { background: var(--navy); color: #fff; font-weight: 700; }
</style>
